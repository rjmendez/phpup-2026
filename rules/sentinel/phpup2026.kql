// phpup-2026 - Microsoft Sentinel KQL Detection Queries
// CVE-2026-109618 / CVE-2026-109619 · PHP longjmp/bailout state corruption · RCE
//
// 2026-10-21 rewrite. The prior revision keyed on a single-request
// multipart-stall heap-spray mechanism (oversized body, forged
// zend_fcall_info byte markers, 100+ identically-named array fields)
// derived from the leaked PoC artifact's own claims. That mechanism does
// not match the real fix (php/php-src commit 82f8f31b16a, "Avoid state
// corruption via bailout") and those queries are retired below, not
// caveated. See ANALYSIS.md for the full mechanism writeup.
//
// The real mechanism is cross-request: a longjmp-interrupted (producer)
// request leaves worker-persistent globals dangling; a later, different
// (consumer) request on the SAME WORKER reads them before its own init
// has run. "Same worker" is not visible from any of these log sources -
// none of them carry a worker/process identifier tied to the request.
// What IS real and network-visible is the producer-side OOM-amplification
// technique (main/rfc1867.c's now-fixed unbounded per-part header count),
// so that's the center of gravity for the queries below.
//
// Table coverage:
//   W3CIISLog              IIS web server logs
//   CommonSecurityLog      WAF / proxy / firewall (CEF)
//   AzureDiagnostics       Azure WAF (App Gateway / Front Door)
//   DeviceNetworkEvents    MDE network events
//   DeviceProcessEvents    MDE process creation
//   SecurityEvent          Windows Security (EventID 4688)


// ── TIER 1: FEATURE PRESENCE (precondition, not an attack signal alone) ──────

// [T1-1] session.upload_progress feature reachable and in use - IIS
// Baseline precondition for the CVE-2026-109619 consumer path specifically.
// Also how the legitimate progress-bar feature is used.
W3CIISLog
| where TimeGenerated > ago(1h)
| where csMethod == "POST"
| where csHeaders has "multipart/form-data" or csUriQuery has "PHP_SESSION_UPLOAD_PROGRESS"
| where csCookie has "PHPSESSID="
| project TimeGenerated, cIP, csHost, csUriStem, csMethod, csBytes, scStatus


// [T1-2] session.upload_progress feature in use - CommonSecurityLog (WAF/proxy)
CommonSecurityLog
| where TimeGenerated > ago(1h)
| where RequestMethod == "POST"
| where Message has "PHP_SESSION_UPLOAD_PROGRESS" and Message has "PHPSESSID="
| project TimeGenerated, SourceIP, DestinationHostName, RequestURL, Message


// ── TIER 2: OOM-AMPLIFICATION PRODUCER SIGNALS (medium-high confidence) ──────
// Grounded directly in the real fix diff. Do NOT require
// PHP_SESSION_UPLOAD_PROGRESS - CVE-2026-109618's OOM trigger works on any
// multipart upload endpoint, not just session.upload_progress users.

// [T2-1] Duplicate Content-Disposition/Content-Type header in one multipart
// part - Azure WAF. The fix (main/rfc1867.c) restricts header saving to
// these two names and skips duplicates; a legitimate part has exactly one
// Content-Disposition (optionally one Content-Type). Requires WAF request
// body inspection enabled.
AzureDiagnostics
| where TimeGenerated > ago(1h)
| where Category in ("ApplicationGatewayAccessLog", "FrontDoorAccessLog")
| where requestBody_s has "multipart/form-data"
| extend CDCount = countof(requestBody_s, "Content-Disposition")
| where CDCount >= 2
| project TimeGenerated, clientIP_s, host_s, requestUri_s, httpStatus_d, CDCount


// [T2-2] High header density in multipart body - IIS (size proxy)
// Coarser signal where body content isn't available: a multipart POST
// whose size is high relative to a typical legitimate file upload's
// form-field overhead can indicate many small header-heavy parts rather
// than one large file. Weak alone - pair with T2-1 or T2-3 where possible.
W3CIISLog
| where TimeGenerated > ago(1h)
| where csMethod == "POST"
| where csHeaders has "multipart/form-data"
| where csBytes >= 40000
| project TimeGenerated, cIP, csHost, csUriStem, csMethod, csBytes, scStatus


// [T2-3] Many empty-file fields or deeply nested field names - Azure WAF
// Advisory text: empty file fields don't count toward max_file_uploads but
// still create file-metadata arrays; nested field names multiply that
// cost. Approximated by counting filename="" occurrences and bracket-
// nesting depth in field names.
AzureDiagnostics
| where TimeGenerated > ago(1h)
| where Category in ("ApplicationGatewayAccessLog", "FrontDoorAccessLog")
| where requestBody_s has "multipart/form-data"
| extend EmptyFileCount = countof(requestBody_s, 'filename=""') + countof(requestBody_s, "filename=''")
| extend NestedFieldNames = extract_all(@'name="([^"]*\[[^"]*\]\[[^"]*\])"', requestBody_s)
| extend NestedFieldCount = array_length(NestedFieldNames)
| where EmptyFileCount >= 10 or NestedFieldCount >= 10
| project TimeGenerated, clientIP_s, host_s, requestUri_s, httpStatus_d, EmptyFileCount, NestedFieldCount


// ── TIER 3: BEHAVIORAL / POST-EXPLOITATION ───────────────────────────────────

// [T3-1] Shell spawned under PHP/web server process - MDE
// Post-exploitation indicator, generically valid regardless of which
// mechanism caused the RCE. Parent: php-fpm, php, lsphp, httpd, nginx.
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| where InitiatingProcessFileName has_any ("php-fpm", "php", "lsphp", "httpd", "apache2", "nginx")
| where FileName has_any ("sh", "bash", "python", "python3", "perl", "curl", "wget", "nc", "ncat", "nmap")
       or ProcessCommandLine has_any ("/bin/sh", "/bin/bash", "bash -i", "python -c", "exec(", "eval(")
| project TimeGenerated, DeviceName, AccountName,
          InitiatingProcessFileName, InitiatingProcessCommandLine,
          FileName, ProcessCommandLine


// [T3-2] Shell spawned under web service account - SecurityEvent 4688
// For environments not running MDE. Requires process creation auditing
// enabled (Security Policy: Audit Process Creation + command-line in audit).
SecurityEvent
| where TimeGenerated > ago(1h)
| where EventID == 4688
| where SubjectUserName has_any ("www-data", "apache", "nobody", "lsphp", "iis apppool")
| where NewProcessName has_any ("sh", "bash", "python", "curl", "wget", "nc")
       or CommandLine has_any ("/bin/sh", "/bin/bash", "bash -i", "python -c")
| project TimeGenerated, Computer, SubjectUserName,
          ParentProcessName, NewProcessName, CommandLine


// [T3-3] Spike in header-duplication hits from a single IP - IIS/Azure WAF
// Burst-over-time complement to T2-1: repeated amplification attempts
// from one source in a short window, regardless of whether any one
// request alone crosses the threshold.
AzureDiagnostics
| where TimeGenerated > ago(15m)
| where Category in ("ApplicationGatewayAccessLog", "FrontDoorAccessLog")
| where requestBody_s has "multipart/form-data"
| extend CDCount = countof(requestBody_s, "Content-Disposition")
| where CDCount >= 2
| summarize
    Hits    = count(),
    Targets = make_set(requestUri_s, 5)
    by bin(TimeGenerated, 5m), clientIP_s, host_s
| where Hits >= 3
| project TimeGenerated, clientIP_s, host_s, Hits, Targets


// [T3-4] Post-exploitation correlation - outbound connection from a host
// that showed a T2-1 amplification hit within the prior hour. Still
// speculative: this does not confirm "same worker," only "same host,
// recently." Tool-agnostic (no distribution-domain IOC).
let suspectHosts =
    AzureDiagnostics
    | where TimeGenerated > ago(1h)
    | where Category in ("ApplicationGatewayAccessLog", "FrontDoorAccessLog")
    | where requestBody_s has "multipart/form-data"
    | extend CDCount = countof(requestBody_s, "Content-Disposition")
    | where CDCount >= 2
    | project MatchTime = TimeGenerated, host_s;
DeviceNetworkEvents
| where TimeGenerated > ago(1h)
| join kind=inner suspectHosts on $left.DeviceName == $right.host_s
| where TimeGenerated between (MatchTime .. (MatchTime + 15m))
| project TimeGenerated, DeviceName, InitiatingProcessFileName,
          RemoteUrl, RemotePort, RemoteIP, MatchTime


// ── HUNTING ───────────────────────────────────────────────────────────────────

// [H1] PHP_SESSION_UPLOAD_PROGRESS in request body - Azure WAF
// Requires WAF request body inspection enabled. Low volume on benign sites.
AzureDiagnostics
| where TimeGenerated > ago(24h)
| where Category in ("ApplicationGatewayAccessLog", "FrontDoorAccessLog")
| where requestBody_s has "PHP_SESSION_UPLOAD_PROGRESS"
| project TimeGenerated, clientIP_s, host_s, requestUri_s,
          httpStatus_d, requestBody_s


// [H2] Distribution of Content-Disposition occurrences per multipart
// request - Azure WAF. Baseline this against normal legitimate multi-file
// upload traffic before setting an alerting threshold on T2-1/T3-3; a form
// with many real file fields also has many Content-Disposition headers,
// just not duplicated ones within a single part.
AzureDiagnostics
| where TimeGenerated > ago(24h)
| where Category in ("ApplicationGatewayAccessLog", "FrontDoorAccessLog")
| where requestBody_s has "multipart/form-data"
| extend CDCount = countof(requestBody_s, "Content-Disposition")
| summarize RequestCount = count() by CDCount
| sort by CDCount asc


// ── RETIRED (2026-10-21) ──────────────────────────────────────────────────────
// Old T1-3/T1-4/T1-5 (oversized body as spray proxy, dangerous-function
//   string in body, forged zend_fcall_info/zval byte markers): built on
//   the dead single-request spray mechanism. The byte-marker query in
//   particular came entirely from the leaked PoC artifact's own code,
//   which VulnCheck reports does not have the correct mechanism.
// Old T2-4 (oversized-body + 200/502/503 crash-ratio): the crash premise
//   was already flagged unvalidated in the prior revision (a real lab
//   test produced a clean 200 OK under the documented precondition) and
//   the premise itself (same-request stall causing a same-request crash)
//   is now known to be the wrong mechanism entirely. Not replaced with a
//   new crash-ratio theory - what the real producer request's HTTP-visible
//   symptom actually looks like (500 page, truncated response, or silent
//   continuation with only a log-side OOM entry) is itself unconfirmed;
//   see ANALYSIS.md's "What we have NOT reproduced."
// Old H2 (100+ identically-named array fields): built on the dead
//   spray-count theory. Replaced by T2-3's empty-file-field/nested-field
//   counting, which maps to a real, fix-confirmed amplification vector
//   instead.
