// phpup-2026 — Microsoft Sentinel KQL Detection Queries
// CVE-2026-109618 / CVE-2026-109619 · PHP session.upload_progress UAF · RCE
//
// Table coverage:
//   W3CIISLog              IIS web server logs
//   CommonSecurityLog      WAF / proxy / firewall (CEF)
//   AzureDiagnostics       Azure WAF (App Gateway / Front Door)
//   DeviceNetworkEvents    MDE network events
//   DeviceProcessEvents    MDE process creation
//   SecurityEvent          Windows Security (EventID 4688)
//
// Detection is keyed on the vulnerability mechanics — the required
// PHP_SESSION_UPLOAD_PROGRESS + PHPSESSID precondition, spray-sized bodies,
// dangerous-function markers, and the forged zend_fcall_info/zval byte
// layout PHP's own struct ABI dictates — not on one released tool's
// hardcoded multipart boundary, User-Agent, session ID, or output canary.
// Those are trivial to change and will not survive a rewritten exploit.
// The one released PoC's literal strings are kept as blocklist-grade IOCs
// in iocs.json's this_artifact_only section, not as detection logic here.
//
// Tier 1 rules are generic/structural — mechanics-based, works against any
//   exploit for this bug class, not just the released PoC.
// Tier 2 rules are behavioral — tune lookback/threshold before alerting.
// Hunting queries need WAF/proxy body inspection enabled; low volume.


// ── TIER 1: GENERIC / MECHANICS-BASED ────────────────────────────────────────

// [T1-1] session.upload_progress feature reachable and in use — IIS
// Baseline precondition for both CVEs. Also how the legitimate progress-bar
// feature is used — inventory/policy signal, not an attack signal alone.
W3CIISLog
| where TimeGenerated > ago(1h)
| where csMethod == "POST"
| where csHeaders has "multipart/form-data" or csUriQuery has "PHP_SESSION_UPLOAD_PROGRESS"
| where csCookie has "PHPSESSID="
| project TimeGenerated, cIP, csHost, csUriStem, csMethod, csBytes, scStatus


// [T1-2] session.upload_progress feature in use — CommonSecurityLog (WAF/proxy)
CommonSecurityLog
| where TimeGenerated > ago(1h)
| where RequestMethod == "POST"
| where Message has "PHP_SESSION_UPLOAD_PROGRESS" and Message has "PHPSESSID="
| project TimeGenerated, SourceIP, DestinationHostName, RequestURL, Message


// [T1-3] Oversized session.upload_progress multipart body — spray heuristic
// Exploitation needs many >=288-byte reclaim blobs to win the freed-arData
// race, far larger than a normal progress-tracked upload's form fields.
// Threshold is a generic spray-size heuristic, not the released PoC's
// specific field count — tune to this environment's normal upload sizes.
W3CIISLog
| where TimeGenerated > ago(1h)
| where csMethod == "POST"
| where csHeaders has "multipart/form-data"
| where csCookie has "PHPSESSID="
| where csBytes >= 40000
| project TimeGenerated, cIP, csHost, csUriStem, csMethod, csBytes, scStatus


// [T1-4] Dangerous function name inside the upload_progress body — Azure WAF
// Generalized past system() to the common command/code execution sinks an
// attacker would pivot a forged zend_fcall_info to. Requires WAF request
// body inspection enabled.
AzureDiagnostics
| where TimeGenerated > ago(24h)
| where Category in ("ApplicationGatewayAccessLog", "FrontDoorAccessLog")
| where requestBody_s has "PHP_SESSION_UPLOAD_PROGRESS"
| where requestBody_s matches regex @"\x00(system|exec|passthru|shell_exec|popen|proc_open)\x00"
| project TimeGenerated, clientIP_s, host_s, requestUri_s, httpStatus_d


// [T1-5] Forged zend_fcall_info/zval structural match — Azure WAF (highest confidence)
// IS_STRING_EX (0x106) and IS_OBJECT_EX (0x308) are zval type-tag constants
// fixed by PHP's own ABI, not by any tool's code; co-occurrence with a
// dangerous-function marker in the same body is strong structural evidence
// of exploitation, independent of tool branding. Requires raw/binary-safe
// body capture — most WAF logs won't preserve the control bytes verbatim,
// so this query is best-effort and should be validated against the
// deployment's actual log encoding before relying on it.
AzureDiagnostics
| where TimeGenerated > ago(24h)
| where Category in ("ApplicationGatewayAccessLog", "FrontDoorAccessLog")
| where requestBody_s has "PHP_SESSION_UPLOAD_PROGRESS"
| where requestBody_s matches regex @"\x06\x01\x00\x00"   // IS_STRING_EX
    and requestBody_s matches regex @"\x08\x03\x00\x00"   // IS_OBJECT_EX
    and requestBody_s matches regex @"\x00(system|exec|passthru|shell_exec|popen|proc_open)\x00"
| project TimeGenerated, clientIP_s, host_s, requestUri_s, httpStatus_d


// ── TIER 2: BEHAVIORAL SIGNALS ────────────────────────────────────────────────

// [T2-1] Shell spawned under PHP/web server process — MDE
// Indicates successful RCE via a dangerous-function call from the forged
// zend_fcall_info chain. Parent: php-fpm, php, lsphp, httpd, nginx.
// Child: shell or recon tools.
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| where InitiatingProcessFileName has_any ("php-fpm", "php", "lsphp", "httpd", "apache2", "nginx")
| where FileName has_any ("sh", "bash", "python", "python3", "perl", "curl", "wget", "nc", "ncat", "nmap")
       or ProcessCommandLine has_any ("/bin/sh", "/bin/bash", "bash -i", "python -c", "exec(", "eval(")
| project TimeGenerated, DeviceName, AccountName,
          InitiatingProcessFileName, InitiatingProcessCommandLine,
          FileName, ProcessCommandLine


// [T2-2] Shell spawned under web service account — SecurityEvent 4688
// For environments not running MDE. Requires process creation auditing enabled
// (Security Policy: Audit Process Creation + command-line in audit).
SecurityEvent
| where TimeGenerated > ago(1h)
| where EventID == 4688
| where SubjectUserName has_any ("www-data", "apache", "nobody", "lsphp", "iis apppool")
| where NewProcessName has_any ("sh", "bash", "python", "curl", "wget", "nc")
       or CommandLine has_any ("/bin/sh", "/bin/bash", "bash -i", "python -c")
| project TimeGenerated, Computer, SubjectUserName,
          ParentProcessName, NewProcessName, CommandLine


// [T2-3] Spike in oversized multipart POSTs from a single IP — IIS
// Burst-over-time complement to T1-3's per-request size threshold.
W3CIISLog
| where TimeGenerated > ago(15m)
| where csMethod == "POST"
| where csBytes >= 40000
| summarize
    PostCount = count(),
    Targets   = make_set(csUriStem, 5)
    by bin(TimeGenerated, 5m), cIP, csHost
| where PostCount >= 3
| project TimeGenerated, cIP, csHost, PostCount, Targets


// [T2-4] Combined pattern — oversized body + worker crash/success mix — IIS
// A crashed PHP worker returns 502/503 (wrong per-build offset guess); a
// successful RCE may return 200 with command output. Multiple large
// multipart POSTs with a crash/success mix from one source is the
// fingerprint of the offset-derivation-then-exploit sequence, regardless
// of which tool produced it.
W3CIISLog
| where TimeGenerated > ago(1h)
| where csMethod == "POST"
| where csCookie has "PHPSESSID="
| where csBytes >= 10000
| where scStatus in ("200", "502", "503")
| summarize
    TotalRequests = count(),
    Status502or503 = countif(scStatus in ("502","503")),
    Status200      = countif(scStatus == "200"),
    MaxBytes       = max(csBytes),
    URIs           = make_set(csUriStem, 5)
    by bin(TimeGenerated, 10m), cIP, csHost
| where TotalRequests >= 2 and Status502or503 >= 1
| extend WorkerCrashRatio = todouble(Status502or503) / todouble(TotalRequests)
| project TimeGenerated, cIP, csHost, TotalRequests, Status200,
          Status502or503, WorkerCrashRatio, MaxBytes, URIs
| sort by WorkerCrashRatio desc


// [T2-5] Post-exploitation correlation — outbound connection from a host that
// showed the Tier 1 structural match within the prior hour. Tool-agnostic
// (no distribution-domain IOC): any destination, correlated purely on host
// + time window against T1-5's structural hit.
let suspectHosts =
    AzureDiagnostics
    | where TimeGenerated > ago(1h)
    | where Category in ("ApplicationGatewayAccessLog", "FrontDoorAccessLog")
    | where requestBody_s has "PHP_SESSION_UPLOAD_PROGRESS"
    | where requestBody_s matches regex @"\x06\x01\x00\x00"
        and requestBody_s matches regex @"\x08\x03\x00\x00"
        and requestBody_s matches regex @"\x00(system|exec|passthru|shell_exec|popen|proc_open)\x00"
    | project MatchTime = TimeGenerated, host_s;
DeviceNetworkEvents
| where TimeGenerated > ago(1h)
| join kind=inner suspectHosts on $left.DeviceName == $right.host_s
| where TimeGenerated between (MatchTime .. (MatchTime + 15m))
| project TimeGenerated, DeviceName, InitiatingProcessFileName,
          RemoteUrl, RemotePort, RemoteIP, MatchTime


// ── HUNTING ───────────────────────────────────────────────────────────────────

// [H1] PHP_SESSION_UPLOAD_PROGRESS in request body — Azure WAF
// Requires WAF request body inspection enabled. Low volume on benign sites.
AzureDiagnostics
| where TimeGenerated > ago(24h)
| where Category in ("ApplicationGatewayAccessLog", "FrontDoorAccessLog")
| where requestBody_s has "PHP_SESSION_UPLOAD_PROGRESS"
| project TimeGenerated, clientIP_s, host_s, requestUri_s,
          httpStatus_d, requestBody_s


// [H2] Repeated identically-named array field — spray heuristic
// A large count of identically-named array fields (t[] in the released PoC;
// field name is arbitrary and attacker-controlled) is how the heap spray is
// delivered. Legitimate apps rarely send 100+ of the same array field in a
// single request; this generalizes past any one tool's chosen field name by
// counting repeated `name="X[]"` patterns rather than matching "t[]" itself.
AzureDiagnostics
| where TimeGenerated > ago(24h)
| where Category in ("ApplicationGatewayAccessLog", "FrontDoorAccessLog")
| extend ArrayFieldNames = extract_all(@'name="([A-Za-z0-9_]+)\[\]"', requestBody_s)
| mv-expand ArrayFieldNames to typeof(string)
| summarize FieldCount = count() by TimeGenerated, clientIP_s, host_s, requestUri_s, httpStatus_d, tostring(ArrayFieldNames)
| where FieldCount >= 100
| project TimeGenerated, clientIP_s, host_s, requestUri_s, httpStatus_d,
          FieldName = ArrayFieldNames, FieldCount
